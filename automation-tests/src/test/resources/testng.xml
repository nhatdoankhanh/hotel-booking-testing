<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Hotel Booking - All UI Tests"
       parallel="false"
       preserve-order="true">

    <test name="Authentication">
        <classes>
            <class name="com.hotelbooking.tests.authentication.RegisterTest"/>
            <class name="com.hotelbooking.tests.authentication.LoginTest"/>
        </classes>
    </test>

    <test name="Hotel Search">
        <classes>
            <class name="com.hotelbooking.hotel.HotelSearchTest"/>
        </classes>
    </test>

    <test name="Booking">
        <classes>
            <class name="com.hotelbooking.booking.BookingTest"/>
        </classes>
    </test>

    <test name="Payment">
        <classes>
            <class name="com.hotelbooking.payment.PaymentTest"/>
        </classes>
    </test>

    <test name="End-to-End">
        <classes>
            <class name="com.hotelbooking.e2e.E2ETest"/>
        </classes>
    </test>

    <test name="Admin Hotel Management">
        <classes>
            <class name="com.hotelbooking.hotel.HotelMagagementTest"/>
        </classes>
    </test>
</suite>